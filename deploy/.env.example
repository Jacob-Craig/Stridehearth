# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Required. Used by both PostgreSQL and Stridehearth.
POSTGRES_PASSWORD=

# Optional. Defaults shown.
# POSTGRES_DB=stridehearth
# POSTGRES_USER=stridehearth
# STRIDEHEARTH_REGISTRATION_MODE=closed

# Optional. External weather for Activities whose device recorded no temperature (docs/self-hosting.md). Off by default.
# Enabling it sends each such Activity's start point (rounded to 0.1 degrees) and start date to Open-Meteo.
# STRIDEHEARTH_WEATHER_PROVIDER=none
